{
  "name": "@infalette/ui",
  "version": "0.1.0",
  "description": "Shared UI components for Infalette applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
