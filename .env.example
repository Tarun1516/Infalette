# =============================================================================
# Infalette Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# For local development, also copy to apps/api/.env and apps/storefront/.env

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
DEBUG=true

# -----------------------------------------------------------------------------
# Database — Neon (Postgres 18.6)
# -----------------------------------------------------------------------------
# Infalette targets Neon as its managed Postgres provider. There are two DSNs
# because Neon exposes separate endpoints:
#
#   DATABASE_URL_POOLED  - transaction-mode pooled endpoint. Used by the API
#                          and workers for all runtime queries. Safe to share
#                          across processes; the pooler multiplexes onto a
#                          small backend connection set.
#   DATABASE_URL_DIRECT  - direct (non-pooled) endpoint. Used ONLY by Alembic
#                          for migrations. DDL with multiple statements and
#                          transaction boundaries does not survive the
#                          transaction-mode pooler reliably.
#
# DATABASE_URL is kept as a fallback for tools that don't distinguish
# (e.g. local dev with the docker-compose.local.yml overlay, ad-hoc psql).
# Resolution order: DATABASE_URL_POOLED > DATABASE_URL.
#
# Examples (replace with values from `neonctl connection-string`):
#   DATABASE_URL_POOLED=postgresql+asyncpg://neondb_owner:<pw>@ep-foo-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   DATABASE_URL_DIRECT=postgresql+asyncpg://neondb_owner:<pw>@ep-foo-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL_POOLED=
DATABASE_URL_DIRECT=
DATABASE_URL=postgresql+asyncpg://infalette:infalette@localhost:5432/infalette

# Legacy Postgres env vars (deprecated). Only used by tools that read
# POSTGRES_HOST/PORT/USER/PASSWORD/DB directly. Prefer DATABASE_URL_* above.
POSTGRES_USER=infalette
POSTGRES_PASSWORD=infalette
POSTGRES_DB=infalette
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Neon metadata (used by scripts/neon_bootstrap.sh and CI branching)
NEON_PROJECT_ID=
NEON_BRANCH=main

# -----------------------------------------------------------------------------
# Redis (Cache, Session Store, Celery Broker)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Authentication (legacy JWT — still used as fallback alongside Clerk)
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ENABLED=true

# -----------------------------------------------------------------------------
# Authentication — Clerk (https://dashboard.clerk.com)
# Use your own Clerk application's app_... ID in place of the example below.
# (See: Clerk Dashboard → App -> Settings -> API keys)
# Application ID: app_xxxxxxxxxxxxxxxxxxxxxxx
# -----------------------------------------------------------------------------
# Frontend (each Next.js app: storefront, admin, platform-admin):
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
#   CLERK_SECRET_KEY=sk_test_...
# Backend (FastAPI verifies Clerk session JWTs via JWKS, syncs via webhook):
#   CLERK_SECRET_KEY=sk_test_...          (same secret; server-side only)
#   CLERK_PUBLISHABLE_KEY=pk_test_...     (same publishable key)
#   CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
#   CLERK_DOMAIN=<your-clerk-domain>      (alternative to JWKS URL)
#   CLERK_WEBHOOK_SECRET=whsec_...        (Clerk Dashboard → Webhooks → user.created/updated/deleted → POST /api/v1/webhooks/clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_DOMAIN=
CLERK_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Payments - Razorpay (India)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Payments - Stripe (International)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# -----------------------------------------------------------------------------
# Social - Instagram
# -----------------------------------------------------------------------------
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
INSTAGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Social - WhatsApp
# -----------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# Email (SES / Postmark)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=ses
EMAIL_FROM=noreply@infalette.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=infalette-media
S3_ENDPOINT=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
POSTHOG_API_KEY=
POSTHOG_HOST=http://localhost:8080

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3000
PLATFORM_ADMIN_URL=http://localhost:3002
API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# -----------------------------------------------------------------------------
# SMS (msg91 / twilio / generic HTTP provider)
# -----------------------------------------------------------------------------
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ENDPOINT_URL=
SMS_ENABLED=false

# -----------------------------------------------------------------------------
# PostHog (Product Analytics)
# -----------------------------------------------------------------------------
POSTHOG_ENABLED=false


# --- Rate limiting (pass 5) ---
# RATE_LIMIT_PER_MINUTE=60
# When true, return 503 if Redis is unavailable instead of skipping rate limits.
# RATE_LIMIT_FAIL_CLOSED=false
